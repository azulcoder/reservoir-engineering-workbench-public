# Byte-compiled and packaging artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Run artefacts. Every computed result is reproducible from a committed configuration
# plus the recorded source revision, so run directories are not tracked. Their
# provenance records are quoted in the case reports, which are tracked.
artifacts/

# A case keeps a small committed snapshot of the run that its report quotes, so a
# reader can check the numbers without re-running anything. Everything else a run
# produces stays out.
!cases/*/results/
cases/*/results/*
!cases/*/results/summary.json
!cases/*/results/run_record.json

# Data policy: nothing under data/ is tracked except the small reviewed reference
# extract and the policy documents. See docs/data_contract.md. Raw and third-party
# field data are acquired locally from the instructions in data/README.md and never
# committed, because access rights and redistribution rights are different rights.
data/*
!data/README.md
!data/reference/
data/reference/*
!data/reference/README.md
!data/reference/MANIFEST.json
# No negation for *.tsv. The NIST extract is not redistributed by this repository, and a
# re-include here would let a copy dropped into the tree be tracked by the next `git add`.
# See docs/release/PUBLIC_DATA_POLICY.md.
!data/raw/
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep

# Simulator inputs and outputs acquired from third parties
decks/
*.UNSMRY
*.UNRST
*.SMSPEC
*.EGRID
*.INIT
*.PRT

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Local run outputs. Every result is reproducible from a committed configuration plus
# the recorded source revision, so run directories are not tracked.
artifacts/

# Local release evidence archives. Built on demand, never published from git.
release-evidence-*.zip
release-evidence-*.zip.sha256

# Release evidence logs are regenerated by each verification run.
docs/release/evidence/logs/
docs/release/evidence/command_log.jsonl

# Machine-readable build records are regenerated by each release run.
docs/release/evidence/build-*.json

# Playwright's own JSON reports and the skip-policy verdict over them. Retained
# locally and in the evidence export; 1.2 MB of per-run output does not belong in
# a published tree. Their digests are recorded in docs/release/FIRST_PUBLICATION.md.
docs/release/evidence/browser/

rc-closure-evidence-*.zip
rc-closure-evidence-*.zip.sha256

# First-publication working notes and bulky run logs. The record itself
# (docs/release/FIRST_PUBLICATION.md) is tracked; its scratch output is not.
.release-work/
