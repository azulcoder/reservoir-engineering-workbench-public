---
/**
 * B1 — infinite-acting radial flow, known answer.
 *
 * The first Stage B study, and the first pressure-transient case in the project. Its
 * headline is deliberately not the six-significant-figure recovery: it is the seeded-defect
 * diagnostic, which finds five analyst errors that put a reported number materially wrong
 * while leaving every diagnostic available without the truth completely silent.
 *
 * Every number on this page is read from the committed canonical snapshot through the
 * checked data path, so a figure and its prose cannot drift apart.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Figure from "../../../components/Figure.astro";
import DataTable from "../../../components/DataTable.astro";
import Callout from "../../../components/Callout.astro";
import ExecutiveBrief from "../../../components/ExecutiveBrief.astro";
import KeyComparison from "../../../components/KeyComparison.astro";
import DefectMatrix from "../../../components/DefectMatrix.astro";
import { checkedExhibit } from "../../../scripts/exhibits";
import * as fmt from "../../../scripts/format";
import { download, readJson } from "../../../scripts/public-data";
import { NAV, NOT_RUN } from "../../../scripts/site";
import { href } from "../../../lib/urls";

const diagnostic = await checkedExhibit("B1-01");
const semilog = await checkedExhibit("B1-02");
const sampling = await checkedExhibit("B1-03");
const noise = await checkedExhibit("B1-04");
const control = await checkedExhibit("B1-05");

const pressureCsv = await download("b1_pressure_and_fit.csv");
const derivativeCsv = await download("b1_derivative.csv");
const visibilityCsv = await download("b1_defect_visibility.csv");
const summaryJson = await download("b1_summary.json");

interface Recovery {
  permeability_md_true: number;
  permeability_md_recovered: number;
  permeability_thickness_true: number;
  permeability_thickness_recovered: number;
  permeability_thickness_relative_error: number;
  skin_true: number;
  skin_recovered: number;
  skin_absolute_error: number;
}
interface VisibilityRow {
  defect: string;
  kind?: string;
  permeability_thickness_relative_error: number;
  permeability_relative_error: number;
  skin_absolute_error: number;
  r_squared: number;
  derivative_versus_fit_relative_difference: number;
  visible_without_truth?: boolean;
  materially_wrong?: boolean;
}
interface Summary {
  config: { truth: Record<string, number>; thresholds: Record<string, number> };
  b1_0_mathematical_baseline: {
    recovery: Recovery;
    fit: { slope_psi_per_cycle: number; r_squared: number };
    window: { first_dimensionless_time: number; last_dimensionless_time: number; points: number };
    derivative: { max_relative_error_against_closed_form: number };
  };
  b1_1_sampling_and_placement: {
    density_error_spread_ratio: number;
    placement_error_spread_ratio: number;
    placement_dominates: boolean;
  };
  b1_2_pressure_noise: {
    levels: Array<{
      sigma_psi: number;
      kh_relative_error_mean: number;
      kh_relative_error_p95: number;
      skin_absolute_error_mean: number;
      skin_absolute_error_p95: number;
    }>;
  };
  b1_3_negative_control: {
    recovery: { permeability_thickness_relative_error: number; skin_absolute_error: number };
    r_squared: number;
  };
  diagnostic_defect_visibility: {
    rows: VisibilityRow[];
    silent_but_materially_wrong: string[];
    silent_but_materially_wrong_count: number;
  };
  criteria: Record<string, boolean>;
  all_criteria_met: boolean;
}
const s = await readJson<Summary>("b1_summary.json");

const recovery = s.b1_0_mathematical_baseline.recovery;
const visibility = s.diagnostic_defect_visibility;
const criteriaMet = Object.values(s.criteria).filter(Boolean).length;
const criteriaTotal = Object.keys(s.criteria).length;

/** Exponent form for the small errors, where the magnitude is the message. Display
 *  precision for every other quantity on this page comes from scripts/format.ts. */
function sci(value: number, digits = 3): string {
  return value.toExponential(digits);
}

const visibilityRows = visibility.rows.map((row) => ({
  defect: row.defect,
  kh: sci(row.permeability_thickness_relative_error, 1),
  k: sci(row.permeability_relative_error, 1),
  skin: sci(row.skin_absolute_error, 1),
  r2: row.r_squared.toFixed(8),
  consistency: sci(row.derivative_versus_fit_relative_difference, 1),
  verdict:
    row.visible_without_truth === undefined
      ? "baseline"
      : row.materially_wrong
        ? row.visible_without_truth
          ? "wrong, and visible"
          : "wrong, and SILENT"
        : "within criteria",
}));

/** The ten seeded errors; the baseline row carries no verdict and is not one of them. */
const seededCount = visibility.rows.filter((r) => r.visible_without_truth !== undefined).length;

const contents = [
  { id: "instrument", label: "1. The instrument works" },
  { id: "visibility", label: "2. What it cannot see" },
  { id: "matters", label: "3. Why this matters" },
  { id: "limits", label: "4. What this does not establish" },
  { id: "technical", label: "5. Technical evidence" },
  { id: "reproduce", label: "Reproduce and download" },
];

const description =
  "B1 recovers a known permeability and skin from a synthetic infinite-acting radial drawdown. Its most useful output is not the recovery but the measurement of which analyst errors the diagnostics cannot see.";
---

<BaseLayout
  title="B1 — infinite-acting radial flow"
  description={description}
  canonicalPath="/studies/b1/"
  nav={NAV}
  contents={contents}
>
  <p class="eyebrow">Study B1 — pressure transient</p>
  <h1>A correct interpretation can still be wrong when its inputs are wrong</h1>

  <ExecutiveBrief>
    <Fragment slot="question">
      Can a simple pressure-transient interpretation recover a known permeability and skin
      from clean data — and once it can, what still makes a convincing interpretation wrong?
    </Fragment>
    <Fragment slot="finding">
      It recovers them essentially exactly. Analyst errors were then seeded into that same
      working interpretation, and{" "}
      <strong>{fmt.outOf(visibility.silent_but_materially_wrong_count, seededCount)} put a reported
      number materially wrong while leaving every diagnostic available without the answer
      unmoved</strong>.
    </Fragment>
    <Fragment slot="implication">
      A well-test inverse can check that an answer is consistent with its own model. It cannot
      check the rate, the net pay, the viscosity or the porosity it was handed. Input QA sits
      outside the calculation, and no amount of fit quality substitutes for it.
    </Fragment>
    <Fragment slot="limit">
      Synthetic throughout, and wellbore storage is zero by declared design — so this says
      nothing about finding where radial flow begins on a real well.
    </Fragment>
  </ExecutiveBrief>

  <section id="instrument" aria-labelledby="instrument-h">
    <h2 id="instrument-h">1. The instrument works</h2>

    <p>
      Before attacking an interpretation it is worth establishing that it is not already
      broken. One well produces at a constant {s.config.truth.rate_stb_per_day} STB/D from a
      homogeneous, infinite reservoir. The forward model evaluates the line-source solution;
      the inverse fits a straight line to drawdown against log time over a window declared in
      advance, and never sees the true parameters.
    </p>

    <KeyComparison
      value={`${fmt.kh(recovery.permeability_thickness_recovered)} md·ft`}
      label="permeability-thickness recovered from the data"
      against={`${fmt.kh(recovery.permeability_thickness_true)} md·ft`}
      againstLabel="known truth, withheld from the inverse"
      gap={`Skin recovered ${fmt.skin(recovery.skin_recovered)} against a known ${fmt.skin(recovery.skin_true)}.`}
    />

    <p>
      Every acceptance threshold was derived from an analytic error estimate and committed
      before any result-producing code existed.{" "}
      {criteriaMet} of {criteriaTotal} criteria are recorded as met in the run's own output.
    </p>

    <p class="note-line">
      A ninth, determinism, is agreement between two separate runs, which
      no single run can record about itself; it is checked by executing the case twice and
      diffing, and is reported in the case report rather than counted here. The recovery is
      exact to about six significant figures — the residue of replacing the exponential
      integral with its logarithmic asymptote, not floating-point noise — and the{" "}
      <a href={href("/studies/b1/#technical")}>technical evidence</a> carries the full values.
    </p>

    <Figure
      id={semilog.id}
      role="hero"
      number={semilog.number}
      title="The straight line that recovers the right answer"
      svg={semilog.svg}
      units={semilog.units}
      interpretation={`The semilog slope gives permeability-thickness ${fmt.kh(recovery.permeability_thickness_recovered)} md·ft against a known ${fmt.kh(recovery.permeability_thickness_true)}, and the line's value at one hour gives skin ${fmt.skin(recovery.skin_recovered)} against a known ${fmt.skin(recovery.skin_true)}.`}
      caveat={semilog.caveat}
      longDescription={semilog.longDescription}
      evidenceClass={semilog.evidenceClass}
      svgDownload={semilog.svgDownload}
      dataDownload={pressureCsv.path}
      dataDownloadLabel={pressureCsv.name}
    />
  </section>

  <section id="visibility" aria-labelledby="visibility-h">
    <h2 id="visibility-h">2. Several wrong interpretations remain internally convincing</h2>

    <p>
      Those errors are listed below. The data never changed;
      only the interpretation did. Each error is scored against the truth, which only this
      study has, and against the two things a real interpretation actually has: the fit's
      r-squared, and whether the derivative plateau agrees with the permeability-thickness the
      regression reports — both computed with the analyst's own, possibly wrong, metadata,
      because that is the only version of the check anyone can run on a real well.
    </p>

    <DefectMatrix rows={visibility.rows} annotate="rate 1.589x wrong (m3/d read as STB/D)" />

    <Callout kind="limitation" title="Nothing inside a well-test interpretation can validate its own inputs">
      <p>
        Every metadata error above is silent: rate, net thickness, wellbore radius, porosity
        and viscosity each leave r-squared at 1 to eight decimals and leave the consistency
        check at its noise floor. This is not a weakness of the implementation but the
        structure of the problem — those quantities enter as multiplicative constants after
        the regression, and the consistency check is blind to them because both sides use the
        same wrong number.
      </p>
      <p>
        Two errors are caught. A wrong time zero curves the data rather than shifting it, so
        r-squared falls visibly. A flipped drawdown sign is invisible in permeability and
        catastrophic in skin, and is caught only if someone plots the derivative and looks at
        it. Those two exceptions are what show the rest are silent for a structural reason and
        not because the diagnostics are weak.
      </p>
    </Callout>

    <p class="note-line">
      This experiment is post-hoc. It was not pre-registered, it gates nothing, and it changed
      no threshold. It is here because the recovery above is a claim about a defect class, and
      a claim about a defect class is worth nothing until the class is measured. Both flags
      are computed in the run and recorded in its summary, so the counts are the artefact's
      and not the author's — the full scored table is in the{" "}
      <a href={href("/studies/b1/#technical")}>technical evidence</a>.
    </p>
  </section>

  <section id="matters" aria-labelledby="matters-h">
    <h2 id="matters-h">3. Why this matters</h2>

    <p>
      A well-test inverse calculation can verify that its answer is consistent with its own
      model. That is a real and useful property, and section 1 is what establishes it. It is
      not the same property as being right.
    </p>

    <p>
      It cannot independently validate the data it was handed. Rate allocation, net pay,
      viscosity and porosity all enter as multiplicative constants after the regression, so an
      error in any of them passes straight through to the reported answer while every
      diagnostic the interpretation can compute stays exactly where it was. The practical
      consequence is that the quality assurance which determines whether a well-test number is
      trustworthy happens before the interpretation starts, on the inputs — not inside it, on
      the fit.
    </p>

    <p>
      Two specific consequences are worth carrying. The regression determines
      permeability-thickness, not permeability: a net-thickness error leaves the reported
      product exactly right and moves the permeability by the full factor, so any statement
      about permeability inherits the whole uncertainty of the net-pay interpretation. And a
      sign error is invisible in permeability and catastrophic in skin, caught only if someone
      plots the derivative and looks at it.
    </p>
  </section>

  <section id="limits" aria-labelledby="limits-h">
    <h2 id="limits-h">4. What this study does not establish</h2>

    <Callout kind="limitation" title="Wellbore storage is zero by design, and that is the largest gap">
      <p>
        Every real drawdown begins storage-dominated, and the storage period both hides the
        early semilog line and interacts with skin. B1 contains no storage at any level, so it
        says nothing about identifying where radial flow actually begins on real data — which
        is the single hardest judgement in a real interpretation, and the one the study's own
        placement result shows is expensive to get wrong.
      </p>
    </Callout>

    <Callout kind="limitation" title="The interpretation window was handed to the estimator">
      <p>
        The window is declared in advance and the inverse does not choose it. The study
        measures what a wrong choice costs; it does not demonstrate making the choice correctly
        from data.
      </p>
    </Callout>

    <Callout kind="limitation" title="The independence is between methods, not between this project and the world">
      <p>
        The data were generated by a solution this project implemented, interpreted by code
        this project wrote, and checked against oracles this project selected. A shared
        convention error would not be caught by any of it. {NOT_RUN.fieldData}
      </p>
    </Callout>

    <Callout kind="limitation" title="No commercial well-test package has been compared against">
      <p>
        <strong>SAPHIR MANUAL COMPARISON — NOT RUN.</strong> A written procedure and an
        exported pressure history exist in the repository so the comparison can be carried out
        by someone who has such a package, with the agreement thresholds to be fixed before the
        external run rather than after seeing it. Nothing on this page may be read as an
        external validation.
      </p>
    </Callout>

    <Callout kind="limitation" title="Not a gas-well result, despite the project's name">
      <p>
        Constant fluid properties throughout. A real gas well requires pseudopressure and
        pseudotime, and the constant viscosity-compressibility assumption fails across a gas
        drawdown. One rate, no rate history, no superposition, no build-up, and no boundary of
        any kind.
      </p>
    </Callout>

    <Callout kind="limitation" title="Skin is a lumped number">
      <p>
        The recovered skin combines formation damage, partial penetration, perforation geometry
        and non-Darcy effects, and this study separates none of them. It is not converted to a
        flow efficiency or a skin radius, and no stimulation decision follows from it.
      </p>
    </Callout>
  </section>

  <section id="technical" aria-labelledby="technical-h">
    <h2 id="technical-h">5. Technical evidence</h2>

    <p>
      The detailed response, the sampling and noise studies, the negative control and the full
      scored defect table. None of this changes the conclusions above; it is what they rest on.
    </p>

    <Figure
      id={diagnostic.id}
      role="technical"
      number={diagnostic.number}
      title={diagnostic.title}
      svg={diagnostic.svg}
      units={diagnostic.units}
      interpretation={`The derivative is flat because the response is a straight line on a semilog plot, which is the definition of the regime. Measured against the closed form the worst error is ${sci(s.b1_0_mathematical_baseline.derivative.max_relative_error_against_closed_form, 2)} relative. A flat derivative identifies the regime; it does not identify the reservoir.`}
      caveat={diagnostic.caveat}
      longDescription={diagnostic.longDescription}
      evidenceClass={diagnostic.evidenceClass}
      svgDownload={diagnostic.svgDownload}
      dataDownload={derivativeCsv.path}
      dataDownloadLabel={derivativeCsv.name}
    />

    <Figure
      id={sampling.id}
      role="technical"
      number={sampling.number}
      title={sampling.title}
      svg={sampling.svg}
      units={sampling.units}
      interpretation={`Density spread ${s.b1_1_sampling_and_placement.density_error_spread_ratio.toFixed(2)}x against placement spread ${Math.round(s.b1_1_sampling_and_placement.placement_error_spread_ratio)}x. Placement dominates — ${s.b1_1_sampling_and_placement.placement_dominates ? "as the protocol predicted before the run" : "contrary to the protocol's prediction"}.`}
      caveat={sampling.caveat}
      longDescription={sampling.longDescription}
      evidenceClass={sampling.evidenceClass}
      svgDownload={sampling.svgDownload}
    />

    <Figure
      id={noise.id}
      role="technical"
      number={noise.number}
      title={noise.title}
      svg={noise.svg}
      units={noise.units}
      interpretation="Two hundred seeds at each of four noise levels. The purpose was to measure degradation, not to demonstrate robustness, and the table below is the measurement."
      caveat={noise.caveat}
      longDescription={noise.longDescription}
      evidenceClass={noise.evidenceClass}
      tableLabel="Data table — degradation under pressure noise"
      tableOpen={true}
      svgDownload={noise.svgDownload}
    >
      <DataTable
        caption="Mean and 95th percentile of the recovery error over 200 seeds per level. For scale, the semilog slope is about 43 psi per cycle, so 0.1 psi is a good gauge and 10 psi is a bad one."
        captionTitle="Table B1-04"
        columns={[
          { key: "sigma", label: "Gauge sigma", unit: "psi", rowHeader: true, numeric: true },
          { key: "khMean", label: "mean |dk/k|", numeric: true },
          { key: "khP95", label: "p95 |dk/k|", numeric: true },
          { key: "sMean", label: "mean |ds|", numeric: true },
          { key: "sP95", label: "p95 |ds|", numeric: true },
        ]}
        rows={s.b1_2_pressure_noise.levels.map((level) => ({
          sigma: level.sigma_psi.toFixed(1),
          khMean: sci(level.kh_relative_error_mean, 2),
          khP95: sci(level.kh_relative_error_p95, 2),
          sMean: sci(level.skin_absolute_error_mean, 2),
          sP95: sci(level.skin_absolute_error_p95, 2),
        }))}
        id="t-b1-04"
      />
      <Fragment slot="footnote">
        <p>
          The error is proportional to the gauge sigma, which is what a linear estimator under
          additive noise must do and is therefore a check on the estimator rather than a
          discovery. At a 10 psi gauge the 95th percentile skin error is
          {" "}{s.b1_2_pressure_noise.levels[s.b1_2_pressure_noise.levels.length - 1].skin_absolute_error_p95.toFixed(2)},
          {" "}which is the difference between reporting a moderately damaged well and a badly
          damaged one. This is also the forgiving noise model: independent, per-point and
          zero-mean. Real gauge error carries shared calibration bias and temporal correlation,
          and a systematic offset is exactly the error class the semilog intercept converts
          straight into skin.
        </p>
      </Fragment>
    </Figure>

    <Figure
      id={control.id}
      role="technical"
      number={control.number}
      title={control.title}
      svg={control.svg}
      units={control.units}
      interpretation={`The negative control must fail, and it does: kh is ${(s.b1_3_negative_control.recovery.permeability_thickness_relative_error * 100).toFixed(2)} percent wrong against a threshold of ${s.config.thresholds.C3_kh_relative}. It fails while producing an r-squared of ${s.b1_3_negative_control.r_squared.toFixed(4)}, which is the point of running it.`}
      caveat={control.caveat}
      longDescription={control.longDescription}
      evidenceClass={control.evidenceClass}
      svgDownload={control.svgDownload}
    />

    <h3>The scored defect table</h3>

    <p>
      Every seeded error with its measured values, which section 2 classifies rather than
      lists. &ldquo;Wrong, and SILENT&rdquo; means the error breached an acceptance criterion
      while moving neither diagnostic.
    </p>

    <DataTable
      caption="Seeded analyst errors. 'Wrong, and SILENT' means the error breached an acceptance criterion while moving neither diagnostic. Both flags are computed in the run, so the verdicts are the artefact's and not the author's."
      captionTitle="Table B1-D1"
      columns={[
        { key: "defect", label: "Seeded error", rowHeader: true },
        { key: "kh", label: "kh error", numeric: true },
        { key: "k", label: "k error", numeric: true },
        { key: "skin", label: "skin error", numeric: true },
        { key: "r2", label: "r-squared", numeric: true },
        { key: "consistency", label: "derivative vs fit", numeric: true },
        { key: "verdict", label: "Verdict" },
      ]}
      rows={visibilityRows}
      id="t-b1-d1"
    />
  </section>

  <section id="reproduce" aria-labelledby="reproduce-h">
    <h2 id="reproduce-h">Reproduce, and download the numbers</h2>

    <pre><code>PYTHONPATH=src python3 cases/B1_iarf_known_answer/run.py \
    --out artifacts/B1_iarf_known_answer/run-local</code></pre>

    <p>
      Python standard library only, a single declared seed base, under a tenth of a second.
      The committed snapshot is the run produced inside the pinned canonical container, where
      it reproduces byte for byte with no tolerance. On any other platform the case must pass
      its own criteria and then survive a semantic comparison against a declared envelope —
      measured at a worst relative difference of 1.11e-10 across 1100 compared values, with
      every quantity shown on this page bit-identical between macOS arm64 and the canonical
      container. The values above are therefore stable to far more digits than they are
      printed to; they are printed to the digits the engineering supports, which is a
      separate and stricter limit. The full-precision values are in the downloads below and
      in the case report.
    </p>

    <ul class="downloads">
      {[pressureCsv, derivativeCsv, visibilityCsv, summaryJson].map((d) => (
        <li>
          <a href={d.href} download>
            {d.name}
          </a>
          <span class="downloads__meta">
            {d.size} — {d.description}
          </span>
        </li>
      ))}
    </ul>

    <p>
      The full case report, with every derivation and the complete limitations list, is{" "}
      <code>cases/B1_iarf_known_answer/report.md</code> in the repository, and the
      pre-registration it was judged against is <code>protocol.md</code> beside it. See also
      {" "}<a href={href("/methods/")}>Methods</a> for how the two reproducibility tiers are
      defined.
    </p>
  </section>

  <style>
    /* Secondary prose: a qualification a reader may skip on the first pass and must be
       able to find on the second. Smaller and lighter than body, never hidden. */
    .note-line {
      font-size: var(--text-sm);
      color: var(--c-ink-3);
      max-width: var(--prose-max);
    }

    .downloads {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .downloads li {
      padding-block: var(--space-2);
      border-block-end: 1px solid var(--c-rule);
    }
    .downloads__meta {
      display: block;
      font-size: var(--text-sm);
      color: var(--c-ink-2);
    }
  </style>
</BaseLayout>
