---
/**
 * A4 — the flagship case.
 *
 * Every number on this page is read at build time from the committed export through
 * `src/lib/figures.ts`, which re-hashes each data file against `contract.json`, or from
 * the generated manifest through `src/scripts/exhibits.ts`. The prose states findings;
 * it does not restate numbers that the tables and figures carry, except where the case's
 * own argument requires two quantities in one sentence.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Figure from "../../../components/Figure.astro";
import DataTable from "../../../components/DataTable.astro";
import Callout from "../../../components/Callout.astro";
import ExecutiveBrief from "../../../components/ExecutiveBrief.astro";
import KeyMetrics from "../../../components/KeyMetrics.astro";
import ExplorerScenarios from "../../../components/ExplorerScenarios.astro";
import { checkedExhibit } from "../../../scripts/exhibits";
import { residualBound } from "../../../scripts/residual";
import { baseScenario, truth } from "../../../scripts/scenarios";
import { download, downloads } from "../../../scripts/public-data";
import { NAV, GATE, FOUR_STATEMENTS, NOT_RUN } from "../../../scripts/site";
import * as fmt from "../../../scripts/format";
import { loadFigureData } from "../../../lib/figures";
import { href, pageHref } from "../../../lib/urls";

const f01 = await checkedExhibit("F01");
const f01b = await checkedExhibit("F01b");
const f02 = await checkedExhibit("F02");
const f03 = await checkedExhibit("F03");
const f04 = await checkedExhibit("F04");
const f05 = await checkedExhibit("F05");
const f06 = await checkedExhibit("F06");
const f07 = await checkedExhibit("F07");
const f08 = await checkedExhibit("F08");

const base = await baseScenario();
const trueG = await truth();

/* ---- F01 / F02: the base case's own 49 observations ---- */
const baseRows = base.years.map((t, i) => ({
  i,
  years: t.toFixed(2),
  frac: (base.gBscf[i] as number / base.trueBscf).toFixed(4),
  g: (base.gBscf[i] as number).toFixed(3),
  p: (base.pressurePsia[i] as number).toFixed(2),
  z: (base.zFactor[i] as number).toFixed(5),
  pz: (base.pz[i] as number).toFixed(2),
  fit: (base.fittedPz[i] as number).toFixed(2),
  res: (base.residual[i] as number).toFixed(2),
}));

const BASE_COLUMNS = [
  { key: "i", label: "Observation", numeric: true, rowHeader: true },
  { key: "years", label: "Time", unit: "years", numeric: true },
  { key: "g", label: "Cumulative gas", unit: "Bscf", numeric: true },
  { key: "frac", label: "G_p / G_true", unit: "fraction", numeric: true },
  { key: "p", label: "Pressure", unit: "psia", numeric: true },
  { key: "z", label: "Deviation factor", unit: "dimensionless", numeric: true },
  { key: "pz", label: "Observed p/Z", unit: "psia", numeric: true },
  { key: "fit", label: "Fitted p/Z", unit: "psia", numeric: true },
  { key: "res", label: "Residual", unit: "psia", numeric: true },
];

/* ---- F03 ---- */
interface F03Row {
  productivity_index_bbl_per_day_psi: number;
  aquifer_time_constant_days: number | null;
  invaded_pore_volume_fraction: number;
  terminal_pressure_psia: number;
  r_squared: number;
  relative_gas_in_place_error: number;
  relative_remaining_gas_error: number;
  bias_over_stderr: number;
  max_abs_residual_psia: number;
}
const f03Data = await loadFigureData<{ rows: F03Row[]; note: string }>("f03_bias_sweep.json");
const f03Rows = f03Data.rows.map((r) => ({
  j: String(Number(r.productivity_index_bbl_per_day_psi.toPrecision(6))),
  tau: r.aquifer_time_constant_days === null ? null : r.aquifer_time_constant_days.toFixed(0),
  we: (r.invaded_pore_volume_fraction * 100).toFixed(2),
  pend: r.terminal_pressure_psia.toFixed(1),
  r2: r.r_squared.toFixed(6),
  err: `${r.relative_gas_in_place_error >= 0 ? "+" : ""}${(r.relative_gas_in_place_error * 100).toFixed(2)}`,
  rem: `${r.relative_remaining_gas_error >= 0 ? "+" : ""}${(r.relative_remaining_gas_error * 100).toFixed(2)}`,
  bse: r.bias_over_stderr.toFixed(1),
  resid: r.max_abs_residual_psia.toPrecision(3),
}));

/* ---- F04 ---- */
interface F04Row {
  productivity_index_bbl_per_day_psi: number;
  history_fraction: number;
  relative_gas_in_place_error: number;
}
const f04Data = await loadFigureData<{ rows: F04Row[]; note: string }>("f04_progressive.json");
const fractions = [...new Set(f04Data.rows.map((r) => r.history_fraction))].sort((a, b) => a - b);
const f04Rows = [...new Set(f04Data.rows.map((r) => r.productivity_index_bbl_per_day_psi))]
  .sort((a, b) => a - b)
  .map((j) => {
    const row: Record<string, string> = { j: String(Number(j.toPrecision(6))) };
    for (const f of fractions) {
      const hit = f04Data.rows.find(
        (r) => r.productivity_index_bbl_per_day_psi === j && r.history_fraction === f,
      );
      const v = hit ? hit.relative_gas_in_place_error * 100 : undefined;
      row[`f${Math.round(f * 100)}`] = v === undefined ? "" : `${v >= 0 ? "+" : ""}${v.toFixed(2)}`;
    }
    return row;
  });
const F04_COLUMNS = [
  { key: "j", label: "J", unit: "bbl/day/psi", numeric: true, rowHeader: true },
  ...fractions.map((f) => ({
    key: `f${Math.round(f * 100)}`,
    label: `${Math.round(f * 100)}% of history`,
    unit: "% error in G",
    numeric: true,
  })),
];

/* ---- F05 ---- */
interface F05 {
  calibration_points: number;
  holdout_points: number;
  split_index: number;
  split_cumulative_gas_bscf: number;
  times_years: number[];
  cumulative_gas_bscf: number[];
  observed_pressure_psia: number[];
  reconstructed_pressure_psia_conditional: Array<number | null>;
  future_synthetic_z_used: Array<number | null>;
  metrics: {
    calibration_relative_gas_in_place_error: number;
    calibration_r_squared: number;
    holdout_rmse_pressure_psia: number;
    holdout_rmse_fraction_of_initial_pressure: number;
    initial_pressure_psia_denominator: number;
    borrowed_demonstration_gate: number;
  };
}
const f05Data = await loadFigureData<F05>("f05_holdout.json");
const m5 = f05Data.metrics;
const f05Rows = f05Data.times_years
  .map((t, i) => ({ t, i }))
  .filter(({ i }) => i >= f05Data.split_index - 1 && (i % 3 === 0 || i === f05Data.times_years.length - 1))
  .map(({ t, i }) => {
    const rec = f05Data.reconstructed_pressure_psia_conditional[i];
    const obs = f05Data.observed_pressure_psia[i] as number;
    return {
      i,
      region: i < f05Data.split_index ? "calibration" : "held out",
      years: t.toFixed(2),
      g: (f05Data.cumulative_gas_bscf[i] as number).toFixed(3),
      obs: obs.toFixed(2),
      rec: rec === null ? null : rec.toFixed(2),
      diff: rec === null ? null : (rec - obs).toFixed(2),
      z: f05Data.future_synthetic_z_used[i] === null ? null : (f05Data.future_synthetic_z_used[i] as number).toFixed(5),
    };
  });

/* ---- F06 ---- */
interface F06 {
  original: {
    rows: Array<{
      pressure_sigma_psi: number;
      detection_rate_water_drive: number;
      detection_rate_volumetric_null: number;
    }>;
    replicates: number;
    seed_note: string;
  };
  post_review_power_curve: {
    rows: Array<{ pressure_sigma_psi: number; detection_rate: number }>;
    replicates: number;
    note: string;
  };
}
const f06Data = await loadFigureData<F06>("f06_detection.json");
const f06Rows = f06Data.original.rows.map((r) => ({
  sigma: r.pressure_sigma_psi.toFixed(0),
  wd: r.detection_rate_water_drive.toFixed(4),
  nul: r.detection_rate_volumetric_null.toFixed(4),
}));
const f06Power = f06Data.post_review_power_curve.rows.map((r) => ({
  sigma: r.pressure_sigma_psi.toFixed(1),
  rate: r.detection_rate.toFixed(5),
}));

/* ---- F07 ---- */
interface F07 {
  values: Record<string, number | string>;
  critical_t: number;
  note: string;
}
const f07Data = await loadFigureData<F07>("f07_z_mismatch.json");
const f07Rows = Object.entries(f07Data.values)
  .filter(([, v]) => typeof v === "number")
  .map(([k, v]) => ({
    q: k.replace(/_/g, " "),
    v: Math.abs(v as number) < 1 ? (v as number).toFixed(6) : (v as number).toFixed(4),
  }));

/* ---- F08 ---- */
interface F08Level {
  timestep_days: number;
  steps: number;
  terminal_water_influx_bbl: number;
  relative_gas_in_place_error: number;
  max_solver_residual_p_over_z_psia: number;
}
interface F08 {
  J_2: { levels: F08Level[]; error_span_over_refinement: number };
  J_60: { levels: F08Level[]; error_span_over_refinement: number };
  note: string;
}
const f08Data = await loadFigureData<F08>("f08_refinement.json");
const f08Rows = (["J_2", "J_60"] as const).flatMap((k) =>
  f08Data[k].levels.map((l) => ({
    j: k === "J_2" ? "2" : "60",
    dt: l.timestep_days.toFixed(4),
    steps: String(l.steps),
    we: l.terminal_water_influx_bbl.toFixed(0),
    err: `${(l.relative_gas_in_place_error * 100).toFixed(6)}`,
    res: residualBound(l.max_solver_residual_p_over_z_psia),
  })),
);

/* ---- Downloads ---- */
const evidenceDownloads = await downloads(
  "f03_bias_sweep.csv",
  "f04_progressive.csv",
  "f05_holdout.csv",
  "f06_detection.csv",
  "f07_z_mismatch.csv",
  "f08_refinement.csv",
);
const f01Csv = await download("f01_f02_scenarios_all.csv");
const f03Json = await download("f03_bias_sweep.json");

const contents = [
  { id: "hero", label: "A convincing line, the wrong inventory" },
  { id: "mechanism", label: "Why aquifer support moves the intercept" },
  { id: "behaviour", label: "The bias grows before the fit looks poor" },
  { id: "holdout", label: "A limited holdout it still passes" },
  { id: "implication", label: "Engineering implication" },
  { id: "limits", label: "What this does not establish" },
  { id: "technical", label: "Technical evidence" },
  { id: "explorer", label: "Scenario explorer" },
  { id: "memo", label: "Decision memo" },
  { id: "reproduce", label: "Reproduce and download" },
  { id: "references", label: "Prior work" },
];

const description =
  "A synthetic counterexample: a volumetric p/Z fit to an aquifer-supported gas reservoir returns R-squared 0.999859 and a gas in place 12.5 percent too high, so a close fit does not by itself establish that the volumetric assumption is appropriate.";
---

<BaseLayout
  title="A4 — when a straight p/Z line is convincing and wrong"
  description={description}
  canonicalPath="/studies/a4/"
  nav={NAV}
  contents={contents}
>
  <p class="eyebrow">Study A4 — flagship case</p>
  <h1>When a straight p/Z line is convincing and wrong</h1>

  <ExecutiveBrief>
    <Fragment slot="question">
      An aquifer supports a dry-gas reservoir that is being interpreted with the volumetric
      p/Z model. How wrong is the recovered gas in place, and could anyone have told from the
      data alone?
    </Fragment>
    <Fragment slot="finding">
      The fit is excellent and the answer is badly wrong. Over most of the range the quality
      of the fit does not indicate the size of the error.
    </Fragment>
    <Fragment slot="implication">
      Goodness of fit is not evidence that the model is the right model. A volumetric p/Z
      estimate needs an independent reason to believe the tank assumption — low water
      production is not one, and neither is a straight line.
    </Fragment>
    <Fragment slot="limit">
      Synthetic throughout, and one drive mechanism. This demonstrates that a convincing fit
      can be structurally wrong; it does not quantify how often that happens on real fields.
    </Fragment>
  </ExecutiveBrief>

  <KeyMetrics
    metrics={[
      { value: fmt.rSquared(base.rSquared), label: "R-squared of the volumetric fit" },
      {
        value: `${fmt.bscf(base.fittedBscf)} Bscf`,
        label: "gas in place the fit reports",
        exception: true,
      },
      {
        value: `${fmt.bscf(base.trueBscf)} Bscf`,
        label: `known truth — the estimate is ${fmt.percent(base.errorPct / 100)} high`,
      },
    ]}
    note="The estimation error is more than a tenth of the inventory, and the fit statistic gives no sign of it."
  />

  <p>
    <strong>Synthetic throughout.</strong> {NOT_RUN.fieldData}
  </p>

  <section id="hero" aria-labelledby="hero-h">
    <h2 id="hero-h">A convincing line, the wrong inventory</h2>

    <Figure
      id={f01.id}
      role="hero"
      number={f01.number}
      title={f01.title}
      titleVisible={false}
      svg={f01.svg}
      units={f01.units}
      interpretation="The observed points and the fitted line are visually indistinguishable over the observed interval, and the line's extrapolated x-intercept lands 12.5 Bscf to the right of the truth."
      caveat={f01.caveat}
      longDescription={f01.longDescription}
      evidenceClass={f01.evidenceClass}
      tableLabel="Data table — all 49 observations of the base case"
      svgDownload={f01.svgDownload}
      dataDownload={f01Csv.path}
      dataDownloadLabel={f01Csv.name}
    >
      <DataTable
        caption={`All ${base.observations} observations of the base case, J = ${base.key} bbl/day/psi, with the fitted ordinate and the residual. This table is the long description of F01, F01b and F02.`}
        captionTitle="Table F01"
        columns={BASE_COLUMNS}
        rows={baseRows}
        id="t-f01"
      />
    </Figure>

    <h3>What to notice</h3>

    <p>
      Over the observed interval the points and the fitted line are visually
      indistinguishable. Everything to the right of the last observation is extrapolation with
      no data behind it, and that is where the two answers separate: the line crosses zero
      {" "}{fmt.bscf(base.fittedBscf - trueG.bscf)} Bscf past the known inventory.
    </p>

    <h3>Why it matters</h3>

    <p>
      The number an engineer takes from this plot is the x-intercept, and the statistic they
      use to decide whether to trust it is the one shown above it. Here the statistic is
      excellent and the intercept is wrong, so the usual check does not do the job it is being
      asked to do.
    </p>

<p>
      The estimation error is {Math.abs(base.biasOverStderr).toFixed(1)} times the fit's
      reported standard error. That standard error is conditional on the fitted model; it
      does not include uncertainty from the omitted support mechanism. A narrower interval
      computed inside the volumetric model would not have contained the truth, because the
      quantity it describes is the precision of a fit, not the accuracy of the inventory.
    </p>

  </section>

  <section id="mechanism" aria-labelledby="mechanism-h">
    <h2 id="mechanism-h">Why aquifer support moves the intercept</h2>

    <p>
      The volumetric interpretation assumes the only thing holding pressure up is the gas
      expanding into the space it already occupies. An aquifer breaks that assumption by
      adding a second source of support: water encroaches, the reservoir gives up less
      pressure for every unit of gas produced, and the pressure history is therefore flatter
      than a closed tank of the same size would produce.
    </p>

    <p>
      A flatter pressure history is exactly what a <em>larger</em> closed tank looks like. The
      p/Z line rotates, its slope shallows, and the x-intercept — which the volumetric model
      reads as gas in place — moves out. The estimator is not malfunctioning. It is answering
      the question it was asked, on a reservoir that does not satisfy the assumption behind
      the question.
    </p>

    <p>
      This also explains why the fit statistic stays high. Influx does not scatter the points;
      it bends the trend gently and systematically, and over a limited observed window a gentle
      bend is well approximated by a straight line. The residuals carry the signature, but they
      carry it as structure rather than as noise, and R-squared is not a test for structure.
    </p>

    <p>
      The straight-line fit is not useless. It is exact when the reservoir really is
      volumetric — the volumetric control in the sweep below recovers the inventory to
      rounding — and at negligible aquifer strength its error is small. What it stops doing,
      once meaningful influx is present, is carrying the information people read from it.
    </p>
  </section>

  <section id="behaviour" aria-labelledby="behaviour-h">
    <h2 id="behaviour-h">The bias grows before the fit looks poor</h2>

    <p>
      Two questions follow immediately: how does the error scale with the amount of support,
      and does watching it for longer help?
    </p>

    <Figure
      id={f03.id}
      role="supporting"
      number={f03.number}
      title={f03.title}
      titleVisible={false}
      svg={f03.svg}
      units={f03.units}
      interpretation="The inventory error rises monotonically with aquifer strength across the whole sweep while R-squared stays at or above 0.995, so the fit statistic does not track the error it is being read as evidence against."
      caveat={f03.caveat}
      longDescription={f03.longDescription}
      evidenceClass={f03.evidenceClass}
      tableLabel="Data table — the eight computed cases"
      tableOpen={true}
      svgDownload={f03.svgDownload}
      dataDownload={f03Json.path}
      dataDownloadLabel={f03Json.name}
    >
      <DataTable
        caption="Aquifer strength against recovered gas in place, for the eight computed cases. The volumetric control has an infinite aquifer time constant, printed as not applicable."
        captionTitle="Table F03"
        columns={[
          { key: "j", label: "J", unit: "bbl/day/psi", numeric: true, rowHeader: true },
          { key: "tau", label: "Time constant", unit: "days", numeric: true },
          { key: "we", label: "Terminal influx", unit: "% of initial HCPV", numeric: true },
          { key: "pend", label: "Terminal pressure", unit: "psia", numeric: true },
          { key: "r2", label: "R-squared", unit: "dimensionless", numeric: true },
          { key: "err", label: "Error in G", unit: "%", numeric: true },
          { key: "rem", label: "Error in G − G_p", unit: "%", numeric: true },
          { key: "bse", label: "Bias / stderr", unit: "ratio", numeric: true },
          { key: "resid", label: "Largest residual", unit: "psia", numeric: true },
        ]}
        rows={f03Rows}
        naText="not applicable, infinite"
        id="t-f03"
      />
      <Fragment slot="footnote">
        <p>
          Two columns matter more than the headline. The bias-over-standard-error column
          runs from about 50 to 88 across the water-drive rows: a narrower confidence
          interval does not help, it makes the answer more confidently wrong, because
          model-structure error is not represented anywhere in the regression's
          uncertainty. The volumetric row is excluded from that reading — its residuals are
          at the 1e-10 level, so its standard error is a rounding artefact and the ratio is
          meaningless. And the quantity an engineer acts on is not G but G − G_p, where the
          same absolute error is expressed against a much smaller denominator.
        </p>
      </Fragment>
    </Figure>

    <Figure
      id={f04.id}
      role="supporting"
      number={f04.number}
      title={f04.title}
      titleVisible={false}
      svg={f04.svg}
      units={f04.units}
      interpretation="Every water-drive row drifts as history accumulates while each individual fit still looks like a clean straight line; the volumetric row is flat at machine precision, as it must be."
      caveat={f04.caveat}
      longDescription={f04.longDescription}
      evidenceClass={f04.evidenceClass}
      tableLabel="Data table — all eight cases at five history fractions"
      tableOpen={true}
      svgDownload={f04.svgDownload}
      dataDownload={evidenceDownloads[1]?.path}
      dataDownloadLabel={evidenceDownloads[1]?.name}
    >
      <DataTable
        caption="Recovered gas in place as a percentage error, from volumetric fits to nested prefixes of one noise-free history at each aquifer setting. The figure draws four of these eight rows; all eight are here."
        captionTitle="Table F04"
        columns={F04_COLUMNS}
        rows={f04Rows}
        id="t-f04"
      />
      <Fragment slot="footnote">
        <p>
          {f04Data.note} The drift is not always upward: for the two strongest aquifers the
          estimate peaks and then falls back as the aquifer itself depletes and its support
          fades, so a stabilising estimate is not evidence that the estimate is right. The
          diagnostic to look for is a material move in <em>either</em> direction while each
          fit remains visually straight.
        </p>
      </Fragment>
    </Figure>
  </section>

  <section id="holdout" aria-labelledby="holdout-h">
    <h2 id="holdout-h">A limited holdout the wrong model still passes</h2>

    <p>
      Withholding the later history and predicting it is the standard defence against a model
      that has been over-fitted. It does not defend against this. The wrong structural model
      reproduces the held-out pressures while its inventory extrapolation stays materially
      biased, because the quantity being tested and the quantity being reported are not the
      same quantity.
    </p>

<Callout kind="note" title="F05, F06 and F07 are fixed-base experiments" id="fixed-base">
      <p>
        The next three exhibits are their own experiments at their own settings. F05 is a
        chronological split of the base case; F06 is two Monte-Carlo noise studies with
        different seeds and replicate counts; F07 is a post-review correlation-mismatch
        check. <strong>None of them responds to the scenario selector below, and the
        selector does not reach them.</strong> They are shown here at the settings their own
        runs used, and a different selection elsewhere on this page does not change them.
      </p>
    </Callout>

    <Figure
      id={f05.id}
      role="supporting"
      number={f05.number}
      title={f05.title}
      titleVisible={false}
      svg={f05.svg}
      units={f05.units}
      interpretation={`Calibrated on the first ${f05Data.calibration_points} of ${f05Data.times_years.length} observations and used to reconstruct the remaining ${f05Data.holdout_points}, a model whose gas in place is ${(m5.calibration_relative_gas_in_place_error * 100).toFixed(2)} percent wrong reconstructs the held-out pressures to ${m5.holdout_rmse_pressure_psia.toFixed(2)} psia, which is ${(m5.holdout_rmse_fraction_of_initial_pressure * 100).toFixed(3)} percent of the initial pressure.`}
      caveat={f05.caveat}
      longDescription={f05.longDescription}
      evidenceClass={f05.evidenceClass}
      tableLabel="Data table — the held-out region"
      svgDownload={f05.svgDownload}
      dataDownload={evidenceDownloads[2]?.path}
      dataDownloadLabel={evidenceDownloads[2]?.name}
    >
      <DataTable
        caption="The split point and the held-out region, every third observation and the last. The calibration region carries no reconstruction and prints as not applicable rather than blank."
        captionTitle="Table F05"
        columns={[
          { key: "i", label: "Observation", numeric: true, rowHeader: true },
          { key: "region", label: "Region" },
          { key: "years", label: "Time", unit: "years", numeric: true },
          { key: "g", label: "Cumulative gas", unit: "Bscf", numeric: true },
          { key: "obs", label: "Observed pressure", unit: "psia", numeric: true },
          { key: "rec", label: "Reconstructed pressure", unit: "psia", numeric: true },
          { key: "diff", label: "Reconstructed minus observed", unit: "psia", numeric: true },
          { key: "z", label: "Held-out state's synthetic Z", unit: "dimensionless", numeric: true },
        ]}
        rows={f05Rows}
        naText="not applicable, calibration region"
        id="t-f05"
      />
      <Fragment slot="footnote">
        <p>
          <strong>This is a conditional reconstruction, not a blind forecast.</strong> The
          predicted pressure is formed by multiplying a predicted p/Z by the noise-free
          deviation factor of the held-out state, evaluated at the true future pressure — the
          last column of the table. Future truth therefore enters the predictor, and an
          analyst holding only the calibration data could not supply it. The chronological
          discipline is real: no tuning of any kind touches the held-out points, and the
          calculation has deliberately not been changed to improve the claim. Only the label
          is corrected.
        </p>
      </Fragment>
    </Figure>

<Callout kind="superseded" title="The gate this row is scored against" id="gate">
      <p>
        <strong>[SUPERSEDED]</strong> An earlier version of this study's report listed both
        J = 0.05 at +0.32 percent and J = 0.2 at +1.26 percent as rows inside a 1 percent
        gate. <strong>+1.26 percent is above a 1 percent gate, not inside it.</strong> Only
        J = 0.05, at +0.32 percent, is below it, and the conclusion is about conditions on
        one row rather than two. The correction runs against the study's own earlier
        conclusion, which is why it is shown rather than quietly applied.
      </p>
      <p>
        The gate itself is also narrower than it was used as. {GATE.scope} {GATE.meaning} The
        reconstruction above clears it at
        {" "}{(m5.holdout_rmse_fraction_of_initial_pressure * 100).toFixed(3)} percent of
        initial pressure against {GATE.value}; that is a project demonstration result and
        nothing more.
      </p>
    </Callout>

    <Callout kind="limitation" title="This is a conditional reconstruction, not a forecast">
      <p>
        The held-out pressures are reconstructed using the synthetic deviation factor from the
        future period, which a real forecast would not have. Nothing here establishes
        independent forecasting capability; what it establishes is that passing a limited
        chronological split does not establish that the structural model is right.
      </p>
    </Callout>
  </section>

  <section id="implication" aria-labelledby="implication-h">
    <h2 id="implication-h">Engineering implication</h2>

    <p>
      Before treating a p/Z x-intercept as a volumetric inventory basis, evaluate
      independently whether the drive assumption is defensible. The fit statistic cannot do
      that, and neither can a limited chronological holdout.
    </p>

    <p>
      Evidence that bears on the question, and which this case shows is not substituted for by
      goodness of fit: water production history, an explicit influx interpretation, geological
      and structural evidence for a connected aquifer, drift in the estimate as history
      accumulates, and whether a competing material-balance model fits the same data equally
      well.
    </p>

    <p>
      This is a synthetic counterexample under declared conditions. It establishes that a
      convincing straight line <em>can</em> be structurally wrong, which is enough to require
      the question be asked. It is not evidence about how often that happens on real fields,
      and it is not an operating procedure.
    </p>
  </section>

  <section id="limits" aria-labelledby="limits-h">
    <h2 id="limits-h">What this study does not establish</h2>

    <Callout kind="note" title="Four statements, kept apart" id="four-statements">
      <p>
        This study reaches the first two and does not reach the last two. Clearing a
        project demonstration gate is evidence about the first two only.
      </p>
      <ol>
        {FOUR_STATEMENTS.map((s) => (
          <li>
            <strong>{s.name}</strong> — {s.text}.
          </li>
        ))}
      </ol>
      <p>
        Quantities are kept apart too. <em>G</em> and <em>G − G_p</em> here are inventory in
        place. Recoverable gas is smaller by whatever the drive mechanism and the
        abandonment condition leave behind, and reserves are a further commercial and
        regulatory classification of a recoverable quantity. Nothing on this page is a
        recoverable volume or a reserve.
      </p>
    </Callout>

    <p>
      These are not footnotes and they are not behind a disclosure. Several of them are the
      study's own retractions.
    </p>

    <Callout kind="limitation" title="It is not field validation">
      <p>
        Both the generator and the estimator are models. A known-answer study with a
        synthetic generator establishes the behaviour of an estimator under a stated
        structural violation. It says nothing about how often that violation occurs in any
        real field, or about the size of the bias in one.
      </p>
    </Callout>

    <Callout kind="limitation" title="The numbers are not general">
      <p>
        The {base.errorPct.toFixed(2)} percent at the base case is a property of these
        declared aquifer parameters, this offtake schedule and this twelve-year window. Only
        the aquifer productivity index is swept; pore volume, compressibility, rate and
        horizon are fixed, so the sweep is one line through a parameter space and not a
        mapped sensitivity surface.
      </p>
    </Callout>

    <Callout kind="limitation" title="Detectability is the weaker half">
      <p>
        It rests on one pre-registered detector, one sampling cadence, independent Gaussian
        pressure error only, a single seed in the pre-registered sweep and a single draw set
        behind the power curve that was introduced to correct it, an uncited 10-to-50-psi
        premise, and a false-positive rate that F07 shows is conditional on the analyst using
        the same deviation-factor correlation as the generator — a condition no field
        analysis meets. If the true band on average-pressure error is 1 to 5 psi rather than
        10 to 50, the detectability conclusion reverses.
      </p>
    </Callout>

    <Callout kind="limitation" title="Excluded mechanisms">
      <p>
        Trapped gas behind the advancing water front is not modelled. Rock and connate-water
        expansion, retrograde condensation, gas dissolved in water, and any areal or
        vertical pressure gradient within the tank are all absent. A geopressured reservoir
        produces a superficially similar p/Z curvature from a completely different mechanism
        and is not distinguished here. The Fetkovich aquifer is itself a model: it is
        pseudosteady from the first timestep and starts in equilibrium with the reservoir, so
        the smooth influx that makes the misfit hard to see is partly assumed rather than
        demonstrated.
      </p>
    </Callout>

    <Callout kind="limitation" title="The history is unrealistically clean">
      <p>
        Constant offtake for twelve years, no shut-ins, no rate or well-count changes, no
        plateau, {base.observations} evenly spaced quarterly points, no gaps and no outliers.
        That cuts both ways: a facilities-constrained plateau carries less curvature
        information and would make the aquifer harder to detect, while real rate variation
        imprints pressure transients that are themselves a diagnostic and would make it
        easier.
      </p>
    </Callout>

    <Callout kind="superseded" title="The average reservoir pressure is assumed unbiased">
      <p>
        <strong>[SUPERSEDED]</strong> An earlier version of this limitation asserted a
        direction: that surviving-well sampling makes a real reservoir worse, not better.
        That sign is not established by anything in this study. The argument for it is that
        the wells surviving to be surveyed are the ones the water has not reached, biasing
        the sample toward the un-swept, higher-pressure part of the tank. The
        counter-argument is that wells shut in long enough to give a usable build-up are not
        a random sample either. <strong>The tank model here has no areal gradient at all, so
        nothing in this study can decide between them.</strong> It is recorded as an untested
        mechanism, and the "the figures are conservative" framing that rested on it is
        withdrawn.
      </p>
    </Callout>

    <Callout kind="superseded" title="An independent reimplementation was claimed and does not exist here">
      <p>
        <strong>[SUPERSEDED]</strong> An earlier version of the report presented a separately
        implemented tank as an independent check of the formulation and quoted its digits.
        No script, no output, no digest, no command and no log for it exists in this
        repository, so none of its figures can be checked from here and the quoted digits are
        withdrawn. What the study's own evidence establishes stops at the solve: the
        estimator-free oracle tests that the implicit coupled step converges to a state
        satisfying the balance, and it does not test the formulation, because an equation
        mis-transcribed identically in the generator and in the oracle would still close.
      </p>
    </Callout>

    <Callout kind="limitation" title="Pre-registration rests on the author's word">
      <p>
        This study's run script declares no inputs in its run record, so nothing
        machine-written pins the protocol to the runs, and every file entered version control
        in a single commit, so no commit timestamp separates the protocol from the runs
        either. <strong>A4's prospective ordering is therefore unverified.</strong> Studies A2
        and A3 do pin their protocol by SHA-256 inside a record the run itself wrote, which
        is internal content linkage as recorded — not an independent trusted timestamp and
        not proof against retrospective construction.
      </p>
    </Callout>

    <Callout kind="limitation" title="No peer review">
      <p>{NOT_RUN.peerReview}</p>
    </Callout>
  </section>

  <section id="technical" aria-labelledby="technical-h">
    <h2 id="technical-h">Technical evidence</h2>

    <p>
      The model and its assumptions, the diagnostic exhibits that ask whether the fault could
      have been detected, and the checks on the generator's own numerics. None of this changes
      the finding above; it is what the finding rests on.
    </p>

    <h3>Model and assumptions</h3>


    <p>
      The histories come from a reservoir tank coupled to a Fetkovich aquifer, solved
      implicitly at every step. The estimator is a constant-pore-volume inventory balance
      with no influx term. They are separate modules and share no balance or fitting code,
      so the bias reported here is a model-structure error and not algebra applied twice in
      the same direction.
    </p>

    <p>
      Reservoir: G = 1.0e11 scf, initial pressure 4000 psia, 180 degF, gas gravity 0.65,
      deviation factor from Dranchuk-Abou-Kassem on Standing dry-gas pseudocriticals, SPE
      standard conditions. Constant offtake of 0.55 G over 12.0 years, 144 monthly
      timesteps, observations every third step. Aquifer: initial aquifer pressure 4000 psia,
      W_i = 3.0e9 bbl, c_t = 6.0e-6 1/psi, so c_t·W_i = 18000 bbl/psi.
      <strong>Only the productivity index is varied.</strong>
    </p>

    <Callout kind="note" title="Where the true inventory comes from">
      <p>
        The known inventory is evaluation-only information that no field measurement
        provides, and it is not a field of the exported data. It is derived on this page as
        {" "}<code>fit.gas_in_place_scf / (1 + relative_gas_in_place_error)</code>, evaluated
        independently for each of the eight cases; the eight agree to better than 1e-9
        relative, and the build stops if they do not. The value is
        {" "}{trueG.bscf.toFixed(6)} Bscf. It is not typed into this page.
      </p>
    </Callout>

